#!/bin/sh
set -eu
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export APPDIR
unset PYTHONHOME PYTHONPATH QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
export LD_LIBRARY_PATH="$APPDIR/usr/lib"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/opt/python3.13/lib/python3.13/site-packages/PySide6/Qt/plugins"
export SSL_CERT_FILE="${SSL_CERT_FILE:-$APPDIR/opt/python3.13/lib/python3.13/site-packages/certifi/cacert.pem}"
exec "$APPDIR/opt/python3.13/bin/python3.13" -I -O -m appglider "$@"
